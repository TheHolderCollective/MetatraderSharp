<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>MetatraderSharp</PackageId>
		<Version>1.0.0</Version>
		<Authors>Rosamund Holder</Authors>
		<TargetFramework>net9.0</TargetFramework>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Description>A C# wrapper library which simplifies the use of MTsocketAPI for MT4 and MT5</Description>
		<PackageProjectUrl>https://github.com/TheHolderCollective/MetatraderSharp</PackageProjectUrl>
		<PackageReleaseNotes>
			* Intial Release
		</PackageReleaseNotes>
		<PackageTags>metatradersharp, mtsocketapi, mt4-api, mt5-api, mt4, mt5, metatrader</PackageTags>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
		</None>
	</ItemGroup>
	
</Project>
